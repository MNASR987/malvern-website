---
// Decorative geometric pattern (eight-point star lattice) used on navy panels.
interface Props { opacity?: number; id?: string }
const { opacity = 0.12, id = 'p' + Math.random().toString(36).slice(2, 7) } = Astro.props;
---
<svg class="pattern" aria-hidden="true" focusable="false" style={`opacity:${opacity}`}>
  <defs>
    <pattern id={id} width="80" height="80" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#C9A24A" stroke-width="1">
        <path d="M40 10 L48 32 L70 40 L48 48 L40 70 L32 48 L10 40 L32 32 Z" />
        <rect x="25" y="25" width="30" height="30" transform="rotate(45 40 40)" />
        <rect x="25" y="25" width="30" height="30" />
        <circle cx="40" cy="40" r="6" />
        <path d="M0 0 L10 10 M80 0 L70 10 M0 80 L10 70 M80 80 L70 70" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
<style>
  .pattern { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; pointer-events: none; }
</style>
