---
import Pattern from './Pattern.astro';
import { getPage, type Lang } from '../lib/content';
import { href } from '../lib/paths';
interface Props { title: string; text?: string; lang?: Lang }
const { title, text, lang = 'en' } = Astro.props;
const ui = getPage('ui', lang);
---
<section class="cta">
  <Pattern opacity={0.1} />
  <div class="container inner reveal">
    <div>
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href={href('/admissions/?type=tour#enquire', lang)}>{ui.buttons.bookTour}</a>
      <a class="btn btn--outline-light" href={href('/admissions/#enquire', lang)}>{ui.buttons.enquire}</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; background: var(--c-primary); color: #D5DCE7; padding-block: clamp(3.5rem, 8vw, 5.5rem); }
  .inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr auto; } }
  h2 { color: #fff; }
  p { margin-block-start: .75rem; font-size: 1.15rem; max-width: 36rem; }
</style>
