---
// School crest (brand/logo.png) with the school name beside it.
// Without a logo file, a gold "M" monogram is shown instead.
import { Image } from 'astro:assets';
import { logo, logoWhite } from '../lib/images';
import { theme } from '../lib/content';
interface Props { light?: boolean; size?: 'sm' | 'md' | 'lg' }
const { light = false, size = 'md' } = Astro.props;
const file = light ? (logoWhite ?? logo) : logo;
const t = theme.logo as any;
const px = { sm: 56, md: 72, lg: 110 }[size];
const name = `${t.wordmarkTop} ${t.wordmarkBottom}`;
const showWords = !file || t.showWordsNextToLogo !== false;
---
<span class:list={['wordmark', { light }, size]}>
  {file
    ? <Image src={file} alt={showWords ? '' : name} height={px} densities={[1, 2]} class="crest" loading="eager" />
    : <span class="mono" aria-hidden="true">{t.monogram}</span>}
  {showWords && <span class="words"><span class="top">{t.wordmarkTop}</span><span class="bottom">{t.wordmarkBottom}</span></span>}
</span>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: .7rem; color: var(--c-primary); }
  .wordmark.light { color: #fff; }
  .sm .crest { block-size: 56px; }
  .md .crest { block-size: 72px; }
  .lg .crest { block-size: 110px; }
  .mono { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border: 1.5px solid var(--c-accent); border-radius: 50%; font: 600 1.45rem/1 var(--font-heading); color: var(--c-accent-text); }
  .light .mono { color: var(--c-accent); }
  .words { display: grid; line-height: 1.05; }
  .top { font: 600 1.4rem/1 var(--font-heading); letter-spacing: .01em; }
  .bottom { font: 600 .62rem/1.2 var(--font-body); letter-spacing: .2em; text-transform: uppercase; margin-block-start: .3rem; opacity: .85; }
  .sm .top { font-size: 1.2rem; }
  .lg .top { font-size: 1.8rem; }
  .lg .bottom { font-size: .72rem; }
  @media (max-width: 420px) { .sm .bottom { letter-spacing: .1em; font-size: .56rem; } .wordmark { gap: .5rem; } .sm .crest { block-size: 48px; } }
</style>
