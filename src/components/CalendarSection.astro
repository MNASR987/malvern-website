---
// Academic calendar key dates (content/en/calendar.yaml), shown on the Parents page.
import Icon from './Icon.astro';
import { getPage, type Lang } from '../lib/content';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const cal = getPage('calendar', lang);
---
<section class="section" id="calendar" aria-labelledby="cal-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Key dates</p>
      <h2 id="cal-h">{cal.title}</h2>
      <p>{cal.intro}</p>
    </div>

    <ul class="stats" role="list">
      {cal.stats.map((s: any) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
    </ul>

    <div class="sems">
      {cal.semesters.map((sem: any) => (
        <article class="sem reveal">
          <header><Icon name="calendar" size={22} /><div><h3>{sem.name}</h3><p>{sem.dates}</p></div></header>
          <ol role="list">
            {sem.events.map((e: any) => (
              <li class={e.type}><span class="dot" aria-hidden="true"></span><span class="d">{e.date}</span><span class="t">{e.text}</span></li>
            ))}
          </ol>
        </article>
      ))}
    </div>

    <ul class="legend" role="list">
      {Object.entries(cal.legend).map(([k, v]) => <li><span class={`sw ${k}`} aria-hidden="true"></span>{v as string}</li>)}
    </ul>
    <p class="note">{cal.note}</p>
  </div>
</section>
<style>
  .stats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--c-border); border: 1px solid var(--c-border); border-radius: var(--radius); overflow: hidden; margin-block-end: 2.5rem; }
  @media (min-width: 760px) { .stats { grid-template-columns: repeat(5, 1fr); } }
  @media (max-width: 759px) { .stats li:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  .stats li { background: #fff; padding: 1.25rem; display: grid; gap: .2rem; text-align: center; }
  .stats strong { font: 700 2rem/1 var(--font-body); color: var(--c-primary); }
  .stats span { font-size: .85rem; color: var(--c-text-muted); }
  .sems { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .sems { grid-template-columns: 1fr 1fr; } }
  .sem { border: 1px solid var(--c-border); border-radius: var(--radius); overflow: hidden; background: #fff; }
  .sem header { display: flex; gap: .85rem; align-items: center; padding: 1.25rem 1.5rem; background: var(--c-primary); color: #fff; }
  .sem header :global(svg) { color: var(--c-accent); flex-shrink: 0; }
  .sem h3 { color: #fff; }
  .sem header p { font-size: .9rem; color: #C9D2E0; }
  .sem ol { list-style: none; padding: .75rem 1.5rem 1.25rem; }
  .sem li { display: grid; grid-template-columns: auto 9.5rem 1fr; gap: .9rem; align-items: baseline; padding-block: .7rem; border-block-end: 1px solid var(--c-border); }
  .sem li:last-child { border: 0; }
  .dot { inline-size: .7rem; block-size: .7rem; border-radius: 50%; background: var(--c-primary); transform: translateY(-1px); }
  .closed .dot, .sw.closed { background: #2E8B57; }
  .ramadan .dot, .sw.ramadan { background: #E0A040; }
  .exam .dot, .sw.exam { background: #6A5ACD; }
  .event .dot, .sw.event { background: var(--c-primary); }
  .d { font-weight: 600; font-size: .9rem; color: var(--c-accent-text); }
  .t { color: var(--c-text); }
  .closed .t { color: #1F6B41; font-weight: 500; }
  .exam .t { font-weight: 600; }
  @media (max-width: 520px) { .sem li { grid-template-columns: auto 1fr; row-gap: .1rem; } .t { grid-column: 2; } }
  .legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: .88rem; color: var(--c-text-muted); margin-block: 1.5rem .5rem; }
  .legend li { display: flex; align-items: center; gap: .5rem; }
  .sw { inline-size: .75rem; block-size: .75rem; border-radius: 50%; }
  .note { font-size: .85rem; color: var(--c-text-muted); }
</style>
