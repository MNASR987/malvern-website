---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Rich from '../components/Rich.astro';
import Icon from '../components/Icon.astro';
import { getPage, settings, type Lang } from '../lib/content';
import { asset } from '../lib/paths';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('parents', lang);
const portal = settings.links.parentPortal;
---
<BaseLayout title={p.seo.title} description={p.seo.description} lang={lang}>
  <PageHero title={p.hero.title} text={p.hero.text}>
    <div class="btn-row" style="margin-block-start:2rem">
      {portal ? <a class="btn btn--gold" href={portal} rel="noopener"><Icon name="lock" size={18} /> {p.portal.button}</a> : <Rich text={p.portal.missing} />}
    </div>
  </PageHero>

  <section class="section">
    <div class="container grid grid--2">
      <article class="card card--gold-top reveal" id="calendar">
        <span class="icon-badge"><Icon name="calendar" /></span>
        <h2>{p.calendar.title}</h2>
        <Rich as="p" text={p.calendar.text} />
        {p.calendar.pdf && <p class="dl"><a class="link-arrow" href={asset(`files/${p.calendar.pdf}`)}>{p.calendar.pdfLabel}</a></p>}
      </article>
      <article class="card card--gold-top reveal" id="uniform">
        <span class="icon-badge"><Icon name="star" /></span>
        <h2>{p.uniform.title}</h2>
        <Rich as="p" text={p.uniform.text} />
      </article>
    </div>
  </section>

  <section class="section section--alt" id="policies" aria-labelledby="pol-h">
    <div class="narrow">
      <div class="section-head"><p class="eyebrow">Policies</p><h2 id="pol-h">{p.policies.title}</h2><Rich as="p" text={p.policies.intro} /></div>
      <ul class="policies" role="list">
        {p.policies.items.map((pol: any) => (
          <li>
            <Icon name="file" size={22} />
            {pol.pdf ? <a href={asset(`files/${pol.pdf}`)}><Rich text={pol.title} /></a> : <Rich text={pol.title} />}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--navy" id="portal" aria-labelledby="portal-h">
    <div class="narrow center">
      <h2 id="portal-h">{p.portal.title}</h2>
      <p class="lead">{p.portal.text}</p>
      {portal ? <a class="btn btn--gold" href={portal} rel="noopener">{p.portal.button}</a> : <Rich as="p" text={p.portal.missing} />}
    </div>
  </section>
</BaseLayout>
<style>
  .card h2 { font-size: clamp(1.5rem, 2.5vw, 1.9rem); margin-block-end: 1rem; }
  .dl { margin-block-start: 1.5rem; }
  .policies { list-style: none; padding: 0; display: grid; gap: .75rem; }
  .policies li { display: flex; gap: 1rem; align-items: center; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1.1rem 1.4rem; }
  .policies :global(svg) { color: var(--c-accent-text); flex-shrink: 0; }
  .center { text-align: center; }
  .lead { font-size: 1.15rem; margin-block: 1rem 2rem; color: #D5DCE7; }
</style>
