---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Rich from '../components/Rich.astro';
import { rich } from '../lib/text';
import Icon from '../components/Icon.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage, settings, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = getPage('about', lang);
const ui = getPage('ui', lang);
---
<BaseLayout title={p.seo.title} description={p.seo.description} lang={lang}>
  <PageHero title={p.hero.title} text={p.hero.text} />

  <section class="section" id="welcome" aria-labelledby="welcome-h">
    <div class="container split split--wide-text">
      <div class="reveal">
        <p class="eyebrow">Welcome</p>
        <h2 id="welcome-h">{p.welcome.title}</h2>
        <div class="welcome-body"><Rich paras text={p.welcome.body} /></div>
        <p class="sign"><Rich as="strong" text={p.welcome.name} /><span>{p.welcome.role}</span></p>
      </div>
      <div class="reveal"><PhotoPlaceholder ratio="4 / 5" label="Principal's photo to come" /></div>
    </div>
  </section>

  <section class="section section--alt" id="vision" aria-labelledby="vision-h">
    <div class="container">
      <h2 id="vision-h" class="visually-hidden">Vision, mission and values</h2>
      <div class="grid grid--2">
        <article class="card statement reveal"><p class="eyebrow">{p.vision.title}</p><p class="big" set:html={rich(p.vision.text)} /></article>
        <article class="card statement reveal"><p class="eyebrow">{p.mission.title}</p><p class="big" set:html={rich(p.mission.text)} /></article>
      </div>
      <h3 class="values-title">{p.values.title}</h3>
      <div class="grid grid--3">
        {p.values.items.map((v: any) => (
          <article class="card card--gold-top reveal"><h4><Rich text={v.title} /></h4><Rich as="p" text={v.text} /></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="video" aria-labelledby="video-h">
    <div class="narrow">
      <h2 id="video-h" class="visually-hidden">{p.video.title}</h2>
      <VideoEmbed url={p.video.url} title={p.video.title} placeholder="[TO CONFIRM: YouTube link for the About page video]" />
    </div>
  </section>

  <section class="section section--alt" id="leadership" aria-labelledby="lead-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Our team</p><h2 id="lead-h">{p.leadership.title}</h2><Rich as="p" text={p.leadership.intro} /></div>
      <div class="grid grid--3">
        {p.leadership.people.map((person: any) => (
          <article class="person reveal">
            <PhotoPlaceholder ratio="1 / 1" photo={person.photo} alt={person.name} label="Photo to come" widths={[400, 600]} />
            <h3><Rich text={person.name} /></h3>
            <p><Rich text={person.role} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="accreditation" aria-labelledby="acc-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Trust</p><h2 id="acc-h">{p.partnerships.title}</h2></div>
      <div class="grid grid--3">
        {p.partnerships.items.map((item: any) => (
          <article class="card reveal"><span class="icon-badge"><Icon name="shield" /></span><h3>{item.title}</h3><Rich as="p" text={item.text} /></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy" id="licensing" aria-labelledby="lic-h">
    <div class="container split">
      <div>
        <p class="eyebrow">Official</p>
        <h2 id="lic-h">{p.licensing.title}</h2>
        <p class="lic-text">{p.licensing.text}</p>
      </div>
      <dl class="lic">
        <div><dt>{ui.footer.licence}</dt><dd dir="ltr">{settings.licence.ministryLicenceNo}</dd></div>
        <div><dt>{ui.footer.unified}</dt><dd dir="ltr">{settings.licence.unifiedNo}</dd></div>
        <div><dt>Girls</dt><dd>KG1 – Grade 12</dd></div>
        <div><dt>Boys</dt><dd>KG1 – Grade 6</dd></div>
      </dl>
    </div>
  </section>

  <CtaBand title="Come and see Malvern for yourself" lang={lang} />
</BaseLayout>
<style>
  .welcome-body { margin-block: 1.5rem; font-size: 1.1rem; }
  .sign { display: grid; gap: .2rem; border-inline-start: 3px solid var(--c-accent); padding-inline-start: 1rem; }
  .sign span { color: var(--c-text-muted); font-size: .95rem; }
  .statement :global(.big) { font: 400 clamp(1.25rem, 2vw, 1.5rem)/1.5 var(--font-heading); color: var(--c-primary); }
  .values-title { margin-block: 3.5rem 1.5rem; }
  .card h4 { margin-block-end: .5rem; }
  .person h3 { margin-block: 1.25rem .25rem; font-size: 1.3rem; }
  .person p { color: var(--c-text-muted); }
  .lic-text { margin-block-start: 1rem; font-size: 1.15rem; }
  .lic { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(201,162,74,.35); border-radius: var(--radius); overflow: hidden; }
  .lic div { background: var(--c-primary); padding: 1.5rem; }
  .lic dt { font-size: .85rem; color: #C9D2E0; }
  .lic dd { margin: .35rem 0 0; font: 650 1.25rem/1.2 var(--font-body); color: var(--c-accent); }
</style>
