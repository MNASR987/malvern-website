---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { href } from '../lib/paths';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <PageHero title="Page not found" text="Sorry, we could not find that page.">
    <div class="btn-row" style="margin-block-start:2rem">
      <a class="btn btn--gold" href={href('/')}>Go to the home page</a>
      <a class="btn btn--outline-light" href={href('/contact/')}>Contact us</a>
    </div>
  </PageHero>
</BaseLayout>
